# Identity Service Environment Variables

# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_secret_key_here

# Database URL (optional - uses in-memory storage if not set)
DATABASE_URL=postgresql+asyncpg://user:password@localhost/signroad

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://pr-generator-yatdm0kx.devinapps.com
