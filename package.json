{
  "name": "signroad-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w @signroad/frontend",
    "dev:admin": "npm run dev -w @signroad/admin",
    "dev:api": "npm run dev -w @signroad/api",
    "build:frontend": "npm run build -w @signroad/frontend",
    "build:admin": "npm run build -w @signroad/admin",
    "build:api": "npm run build -w @signroad/api",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev:frontend"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
