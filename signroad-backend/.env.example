# SignRoad Backend Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# JWT Configuration (REQUIRED)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://pr-generator-yatdm0kx.devinapps.com

# ============================================
# Default Users (Optional - for development only)
# ============================================
# Admin user (optional - use create_admin.py script instead)
# DEFAULT_ADMIN_EMAIL=admin@signroad.com
# DEFAULT_ADMIN_PASSWORD_HASH=<bcrypt-hash>

# Test user (optional - for development/testing)
# DEFAULT_TEST_EMAIL=test@signroad.com
# DEFAULT_TEST_PASSWORD_HASH=<bcrypt-hash>

# ============================================
# Environment
# ============================================
ENVIRONMENT=development  # or production, staging

# ============================================
# Database (Future - after migration)
# ============================================
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/signroad

# ============================================
# Email Service (Future - for email verification)
# ============================================
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@signroad.com

# ============================================
# Object Storage (Future - for photo uploads)
# ============================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-west-2
# S3_BUCKET_NAME=signroad-user-photos

# ============================================
# Monitoring (Future - for error tracking)
# ============================================
# SENTRY_DSN=your-sentry-dsn

# ============================================
# Redis (Future - for rate limiting and caching)
# ============================================
# REDIS_URL=redis://localhost:6379
